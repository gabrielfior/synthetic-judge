# Copie para .env.local e preencha. Chave em https://opencode.ai/auth
OPENCODE_API_KEY=

# Modelo do OpenCode Zen. Padrão: claude-opus-5.
# Os modelos "-free" do Zen NÃO servem aqui: pela API eles devolvem
# "OpenCode's free tier can only be used in OpenCode" (HTTP 400). Para gastar
# menos, use um Claude mais barato: claude-sonnet-5 ou claude-haiku-4-5.
# SJ_MODEL=claude-opus-5

# Quantos caracteres de cada sentença entram no system prompt. Padrão: 4000,
# que é o corte medido como suficiente para alcançar o dispositivo. Abaixar para
# 2000 corta antes da decisão na maioria das sentenças deste juiz.
# SJ_TRUNC_CHARS=4000

# Caminho do corpus. Sem isto, a app sobe a árvore de diretórios procurando
# data/sentencas_juiz.json — o que acha o data/ do repo principal mesmo rodando
# de dentro de um worktree.
# SJ_CORPUS_PATH=/caminho/para/data/sentencas_juiz.json

# Endpoint. O provider é Anthropic-shaped (POST {SJ_BASE_URL}/messages com
# x-api-key), então só aponte para um endpoint que fale esse formato.
# SJ_BASE_URL=https://opencode.ai/zen/v1
